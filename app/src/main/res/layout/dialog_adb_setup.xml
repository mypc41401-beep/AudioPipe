<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Use split screen: keep AudioPipe and Developer options → Wireless debugging open together. Tap Pair device with pairing code. Enter its port and six-digit code below. Pair AudioPipe separately; Shizuku Running alone is not enough."
            android:layout_marginBottom="12dp" />
        <Button android:id="@+id/developerSettingsButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Open Developer options" />
        <EditText android:id="@+id/pairingPortInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLength="5"
            android:hint="Pairing port (from the pairing-code dialog)" android:singleLine="true" />
        <Button android:id="@+id/discoverPairingButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Find pairing port automatically" />
        <EditText android:id="@+id/pairingCodeInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="numberPassword" android:maxLength="6"
            android:saveEnabled="false" android:importantForAutofill="no"
            android:hint="Six-digit pairing code" android:singleLine="true" />
        <Button android:id="@+id/pairAdbButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Pair and connect" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Already paired? The connection port is on the MAIN Wireless debugging page under IP address &amp; port. It is different from the pairing port. Leave blank for automatic discovery." />
        <EditText android:id="@+id/connectionPortInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" android:maxLength="5"
            android:hint="Connection port (optional)" android:singleLine="true" />
        <Button android:id="@+id/connectAdbButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Connect / verify shell" />
        <TextView android:id="@+id/adbSetupMessage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
